# =============================================================
# D'Helenas Backend — Environment Variables
# =============================================================
# Copy to .env for local dev, or set in Railway dashboard for production.

# ─── Database ─────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql://dhelenas:dhelenas@postgres:5432/dhelenas
# Production (Supabase):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Supabase ─────────────────────────────────────────────
# When set, backend uses Supabase Auth + Storage.
# When empty, backend falls back to Express JWT + local upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (local dev only — ignored when SUPABASE_URL is set) ───
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Production: set to your frontend domain (e.g. https://dhelenas.vercel.app)
CORS_ORIGIN=*

# ─── File Upload ──────────────────────────────────────────
# Local dev only — when SUPABASE_URL is set, uses Supabase Storage
UPLOAD_DIR=/app/uploads

# ─── Email (Resend) ───────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
# Exact sender addresses approved by the operator, separated by commas.
# EMAIL_FROM is also allowed. This does not assert Resend domain verification.
EMAIL_ALLOWED_SENDERS=
EMAIL_REPLY_TO=

# ─── WhatsApp Business Cloud API ─────────────────────────
# Get credentials at https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ─── Mercado Pago (future) ────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_TEST_PUBLIC_KEY=
MERCADO_PAGO_PRODUCTION_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_MODE=test
# Off by default. Only newly created orders while enabled receive an expiry marker.
ORDER_RESERVATION_EXPIRY_ENABLED=false
ORDER_RESERVATION_TTL_MINUTES=60
# Refunds remain off until the read-only preview has been reviewed.
# Even when enabled, code limits this TEST release to R$ 1,00 on DH-2026-000006.
AFTER_SALES_REFUNDS_ENABLED=false

# ─── Melhor Envio (future) ────────────────────────────────
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_MODE=sandbox
# Required to use MELHOR_ENVIO_TOKEN; must match MELHOR_ENVIO_MODE.
MELHOR_ENVIO_TOKEN_MODE=sandbox
MELHOR_ENVIO_USER_AGENT="D'Helenas (atendimento@dhelenas.com.br)"
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://api.dhelenas.com/api/integrations/melhor-envio/oauth/callback
# Production never borrows the legacy Sandbox client credentials.
# Register this exact callback on the Production application before authorizing.
MELHOR_ENVIO_PRODUCTION_CLIENT_ID=
MELHOR_ENVIO_PRODUCTION_CLIENT_SECRET=
MELHOR_ENVIO_PRODUCTION_USER_AGENT=
MELHOR_ENVIO_PRODUCTION_REDIRECT_URI=https://api.dhelenas.com/api/integrations/melhor-envio/oauth/production/callback
# Reuse the existing key used by integration_configs; never rotate it for OAuth.
INTEGRATION_ENCRYPTION_KEY=
# App Secret configured in Melhor Envio's webhook settings; never use the API token here.
MELHOR_ENVIO_WEBHOOK_SECRET=

# Hold Pix price offer until isolated homologation and Juliane approval.
# Also requires payments.pix_discount_enabled=true and a validated percentage
# (proposed 5%, maximum 30%) in the admin; never enabled by Pix token presence.
PIX_DISCOUNT_ENABLED=false

# Publish preparation + carrier business days only after commercial approval.
# Default proposed preparation: 2; settings.shipping.melhor_envio_extra_days may override.
SHIPPING_PREPARATION_ENABLED=false

# Requires explicit commercial approval and zero-rate provider plans for the card.
# Maximum supported by this store: 6. Debit always uses one installment.
CREDIT_INSTALLMENTS_APPROVED=false
# Enable only after Orders API 3DS homologation for this account.
CARD_3DS_ENABLED=false

# Future operational gates. Do not activate during implementation or without homologation.
# Email requires separately authorized migration 015, a verified Resend domain and sender.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_ENVIRONMENT=production
# Receipts persist while this worker is off; legacy events are never auto-replayed.
SHIPPING_TRACKING_WORKER_ENABLED=false
# Preparing a cart does not buy postage. Buying requires an explicit fresh price confirmation.
SHIPPING_LABEL_PURCHASE_ENABLED=false
# General refunds require both gates and an authenticated Supabase admin confirmation.
# This preserves the previous historical TEST fence; it does not reopen old attempts.
AFTER_SALES_OPERATIONAL_ENABLED=false

# Optional owner-only collaborator management. Keep disabled until migrations 016/017
# and an independently verified owner identity are explicitly approved and installed.
ADMIN_ACCESS_MANAGEMENT_ENABLED=false
