# =============================================================
# D'Helenas Backend — Environment Variables
# =============================================================
# Copy to .env for local dev, or set in Railway dashboard for production.

# ─── Database ─────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql://dhelenas:dhelenas@postgres:5432/dhelenas
# Production (Supabase):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Supabase ─────────────────────────────────────────────
# When set, backend uses Supabase Auth + Storage.
# When empty, backend falls back to Express JWT + local upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (local dev only — ignored when SUPABASE_URL is set) ───
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Production: set to your frontend domain (e.g. https://dhelenas.vercel.app)
CORS_ORIGIN=*

# ─── File Upload ──────────────────────────────────────────
# Local dev only — when SUPABASE_URL is set, uses Supabase Storage
UPLOAD_DIR=/app/uploads

# ─── Email (Resend) ───────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM="D'Helenas <noreply@dhelenas.com.br>"

# ─── WhatsApp Business Cloud API ─────────────────────────
# Get credentials at https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ─── Mercado Pago (future) ────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ─── Melhor Envio (future) ────────────────────────────────
MELHOR_ENVIO_TOKEN=
