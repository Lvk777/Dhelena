# =============================================================
# D'Helenas Frontend — Environment Variables
# =============================================================

# ─── API URL ──────────────────────────────────────────────
# Dev (Vite proxy): leave empty — requests go through /api proxy
# Production: set to your Railway backend URL
VITE_API_URL=

# ─── Supabase ─────────────────────────────────────────────
# When set, frontend uses Supabase Auth + Storage
# When empty, frontend uses Express auth via API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
